#!/bin/sh
set -eu

lb config \
  --mode debian \
  --distribution forky \
  --distribution-chroot forky \
  --distribution-binary forky \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "https://deb.debian.org/debian/" \
  --mirror-chroot "https://deb.debian.org/debian/" \
  --mirror-binary "https://deb.debian.org/debian/" \
  --parent-mirror-bootstrap "https://deb.debian.org/debian/" \
  --parent-mirror-chroot "https://deb.debian.org/debian/" \
  --debian-installer none \
  --binary-images iso-hybrid \
  --bootappend-live "boot=live components username=nnos" \
  --apt-recommends true \
  --apt-indices false \
  --memtest none \
  --checksums sha256 \
  --iso-application "NugasNugisOS" \
  --iso-publisher "NugasNugisOS Project" \
  --iso-volume "NNOS_0.1.0"
